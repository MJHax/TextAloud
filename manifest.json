{
  "manifest_version": 3,
  "name": "TextAloud — OpenRouter TTS",
  "version": "1.0.0",
  "description": "Highlight text on any page and read it aloud using OpenRouter text-to-speech models, with a live price estimate.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "contextMenus", "offscreen"],
  "host_permissions": ["https://openrouter.ai/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TextAloud",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
